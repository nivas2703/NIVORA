{
  "hosting": {
    "target": "nivora",
    "public": "dist",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/folivio",
        "destination": "/folivio.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
